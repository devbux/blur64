{
  "name": "blur64",
  "version": "1.4.0",
  "description": "Generate base64-encoded blurred image placeholders using Sharp.",
  "author": "devbux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devbux/blur64.git"
  },
  "homepage": "https://devbux.github.io/blur64",
  "bugs": {
    "url": "https://github.com/devbux/blur64/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.mjs",
      "require": "./dist/nextjs.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/cleanup-dts.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "image",
    "blur",
    "base64",
    "sharp",
    "placeholder",
    "blur64",
    "blurhash",
    "nextjs",
    "react"
  ],
  "peerDependencies": {
    "sharp": "^0.33.5 || ^0.34.2 || ^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "browser": false,
  "sideEffects": false
}
